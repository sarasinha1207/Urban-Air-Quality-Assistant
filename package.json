{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "GenAI assistant for low-emission routines and indoor air hacks during severe smog.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . -c eslint.quality.config.mjs --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev --audit-level=low",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
