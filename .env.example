# Copy to .env.local (never commit it). Set the same variables in the Vercel project settings.

# Required. Create a key at https://aistudio.google.com/apikey. Server-side only: no NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional. Comma-separated Gemini models, tried in order; if one is exhausted, overloaded or retired
# the app switches to the next. Defaults to: gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest,gemini-flash-latest
GEMINI_MODELS=

# Optional. Makes the rate limits hold across every serverless instance. Create a free Redis database
# at https://upstash.com (or add the Vercel KV integration, which sets the KV_REST_API_* names).
# Without them each instance counts on its own, which still works. HTTPS URLs only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
