# Copy to .env.local (never commit it). Set the same variables in the Vercel project settings.

# Required. Create a key at https://aistudio.google.com/apikey. Server-side only: no NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional. Comma-separated Gemini models, tried in order; if one is exhausted, overloaded or retired
# the app switches to the next. Defaults to: gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_MODELS=
